# macOS
.DS_Store

# Xcode / build
build/
dist/
DerivedData/
*.xcodeproj
*.xcworkspace
xcuserdata/
*.xcuserstate

# Secrets — TMDB API key, never commit
Airpisode/TMDBKey.xcconfig

# Secrets — Sparkle feed URL and EdDSA public key for this machine/CI
Airpisode/Config/Sparkle.local.xcconfig

# Sparkle's private EdDSA key: exporting it to a file is only for CI
*.sparkle-ed-key
sparkle_ed_private_key

# Swift Package Manager (if ever added)
.build/
.swiftpm/

# Temporary persistence files
*.tmp

# Profiler output
*.profraw
